---
import BaseLayout from '../layouts/BaseLayout.astro';
import animeData from '../data/anime.json';

interface Anime { year: number | string; season: number; title: string; rating: number; yuri: boolean }
const anime = animeData as Anime[];
---

<BaseLayout title="애니메이션" description="지금까지 본 애니메이션과 개인적인 평점 기록입니다.">
  <section class="page">
    <header class="page-header">
      <p class="eyebrow">Archive</p>
      <h1>애니메이션</h1>
      <p>지금까지 본 {anime.length}편의 개인적인 기록입니다.</p>
    </header>

    <div class="anime-tools" aria-label="목록 필터">
      <button class="filter-button" type="button" data-filter="all" aria-pressed="true">전체</button>
      <button class="filter-button" type="button" data-filter="favorite" aria-pressed="false">★ 4–5</button>
      <button class="filter-button" type="button" data-filter="yuri" aria-pressed="false">백합</button>
    </div>

    <ol class="anime-list">
      {anime.map((item) => (
        <li class="anime-item" data-rating={item.rating} data-yuri={String(item.yuri)}>
          <span class="anime-year">{item.year}</span>
          <span>{item.title}</span>
          <span class="anime-rating" aria-label={`${item.rating}점`}>{'★'.repeat(item.rating)}</span>
        </li>
      ))}
    </ol>
  </section>

  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('.anime-item');
    buttons.forEach((button) => button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((candidate) => candidate.setAttribute('aria-pressed', String(candidate === button)));
      items.forEach((item) => {
        item.hidden = filter === 'favorite'
          ? Number(item.dataset.rating) < 4
          : filter === 'yuri' ? item.dataset.yuri !== 'true' : false;
      });
    }));
  </script>
</BaseLayout>
