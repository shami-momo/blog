---
import BaseLayout from '../layouts/BaseLayout.astro';
import { photoPaths, photos } from '../data/photos';
---

<BaseLayout title="사진" description="여행하며 기록한 풍경과 순간들입니다.">
  <section class="page page-wide">
    <header class="page-header">
      <p class="eyebrow">Photography</p>
      <h1>사진</h1>
      <p>여행하며 오래 기억하고 싶은 장면을 모았습니다.</p>
    </header>

    <ol class="photo-grid" aria-label="여행 사진 갤러리">
      {photos.map(([file, caption, alt]) => {
        const paths = photoPaths(file);
        return (
          <li>
            <button class="photo-button" type="button" data-full={paths.full} data-caption={caption} aria-label={`사진 크게 보기: ${alt}`}>
              <span class="photo-frame">
                <img src={paths.thumbnail} alt={alt} width="720" height="720" loading="lazy" decoding="async" />
              </span>
              <span class="photo-caption">{caption}</span>
            </button>
          </li>
        );
      })}
    </ol>
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="사진 크게 보기">
    <button class="icon-button lightbox-close" type="button" aria-label="닫기">×</button>
    <figure>
      <img id="lightbox-image" alt="" />
      <figcaption id="lightbox-caption"></figcaption>
    </figure>
  </dialog>

  <script>
    const lightbox = document.querySelector<HTMLDialogElement>('#lightbox');
    const lightboxImage = document.querySelector<HTMLImageElement>('#lightbox-image');
    const lightboxCaption = document.querySelector<HTMLElement>('#lightbox-caption');
    let lastTrigger: HTMLButtonElement | null = null;

    document.querySelectorAll<HTMLButtonElement>('.photo-button').forEach((button) => {
      button.addEventListener('click', () => {
        if (!lightbox || !lightboxImage || !lightboxCaption) return;
        lastTrigger = button;
        lightboxImage.src = button.dataset.full ?? '';
        lightboxImage.alt = button.getAttribute('aria-label')?.replace('사진 크게 보기: ', '') ?? '';
        lightboxCaption.textContent = button.dataset.caption ?? '';
        lightbox.showModal();
      });
    });

    lightbox?.querySelector('.lightbox-close')?.addEventListener('click', () => lightbox.close());
    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) lightbox.close();
    });
    lightbox?.addEventListener('close', () => {
      lightboxImage?.removeAttribute('src');
      lastTrigger?.focus();
    });
  </script>
</BaseLayout>
