---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image, getImage } from 'astro:assets';
import { photoAsset, photos } from '../data/photos';
import '../styles/photos.css';

// Match the site's padding and the gallery's two/three columns, including gaps.
const gallerySizes = '(max-width: 640px) calc((100vw - 2.75rem) / 2), (max-width: 768px) calc((100vw - 4rem) / 3), calc(704px / 3)';
const galleryPhotos = await Promise.all(photos.map(async ([file, caption, alt]) => {
  const source = photoAsset(file);
  const reduced = await Promise.all([640, 960, 1440]
    .filter((width) => width < source.width)
    .map((width) => getImage({ src: source, width, format: 'webp', quality: 85 })));
  // Keep the already-compressed original as the largest candidate, without re-encoding.
  const fullSrcset = [...reduced.map((image) => `${image.src} ${image.options.width}w`), `${source.src} ${source.width}w`].join(', ');
  const ratio = source.width / source.height;
  const fullSizes = `(max-width: 640px) min(calc(100vw - 2.5rem), calc((100dvh - 8rem) * ${ratio})), min(88vw, 1400px, calc((100dvh - 7rem) * ${ratio}))`;
  return { source, caption, alt, fullSrcset, fullSizes };
}));
---

<BaseLayout title="사진" description="여행하며 찍은 사진들">
  <article>
    <header class="page-header">
      <h1>사진</h1>
    </header>

    <ol class="photo-grid" aria-label="여행 사진 갤러리">
      {galleryPhotos.map(({ source, caption, alt, fullSrcset, fullSizes }, index) => (
        <li class="photo-item">
          <button class="photo-trigger" type="button" data-photo data-full={source.src} data-full-srcset={fullSrcset} data-full-sizes={fullSizes} data-caption={caption} aria-label={`사진 크게 보기: ${alt}`}>
            <Image src={source} alt={alt} width={720} widths={[240, 360, 480, 720, 960]} sizes={gallerySizes} quality={85} layout="constrained" priority={index === 0} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="photo-description">{caption}</span>
          </button>
        </li>
      ))}
    </ol>
  </article>

  <dialog class="photo-lightbox" id="photo-lightbox" aria-label="사진 크게 보기">
    <div class="photo-lightbox-inner">
      <button class="photo-lightbox-close" type="button" aria-label="사진 닫기">×</button>
      <button class="photo-lightbox-nav photo-lightbox-prev" type="button" aria-label="이전 사진">←</button>
      <figure class="photo-lightbox-figure">
        <img class="photo-lightbox-image" alt="" decoding="async" />
        <figcaption class="photo-lightbox-caption" aria-live="polite">
          <span id="photo-lightbox-caption"></span>
          <span class="photo-lightbox-count"></span>
        </figcaption>
      </figure>
      <button class="photo-lightbox-nav photo-lightbox-next" type="button" aria-label="다음 사진">→</button>
    </div>
  </dialog>

  <script>
    const dialog = document.querySelector<HTMLDialogElement>('#photo-lightbox');
    const triggers = [...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];
    const image = dialog?.querySelector<HTMLImageElement>('.photo-lightbox-image');
    const caption = dialog?.querySelector<HTMLElement>('#photo-lightbox-caption');
    const count = dialog?.querySelector<HTMLElement>('.photo-lightbox-count');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('.photo-lightbox-close');
    let currentIndex = 0;
    let lastTrigger: HTMLButtonElement | null = null;

    const showPhoto = (index: number) => {
      if (!image || !caption || !count || triggers.length === 0) return;
      currentIndex = (index + triggers.length) % triggers.length;
      const trigger = triggers[currentIndex];
      const thumbnail = trigger.querySelector('img');
      // Set selection hints before src so opening does not first request the original.
      image.sizes = trigger.dataset.fullSizes ?? '100vw';
      image.srcset = trigger.dataset.fullSrcset ?? '';
      image.src = trigger.dataset.full ?? '';
      image.alt = thumbnail?.alt ?? '';
      caption.textContent = trigger.dataset.caption ?? '';
      count.textContent = `${currentIndex + 1} / ${triggers.length}`;
    };

    triggers.forEach((trigger, index) => trigger.addEventListener('click', () => {
      if (!dialog) return;
      lastTrigger = trigger;
      showPhoto(index);
      dialog.showModal();
      closeButton?.focus();
    }));

    closeButton?.addEventListener('click', () => dialog?.close());
    dialog?.querySelector('.photo-lightbox-prev')?.addEventListener('click', () => showPhoto(currentIndex - 1));
    dialog?.querySelector('.photo-lightbox-next')?.addEventListener('click', () => showPhoto(currentIndex + 1));
    dialog?.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') showPhoto(currentIndex - 1);
      if (event.key === 'ArrowRight') showPhoto(currentIndex + 1);
      if (event.key === 'Home') showPhoto(0);
      if (event.key === 'End') showPhoto(triggers.length - 1);
    });
    dialog?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('.photo-lightbox-figure, .photo-lightbox-close, .photo-lightbox-nav')) dialog.close();
    });
    dialog?.addEventListener('close', () => {
      image?.removeAttribute('src');
      image?.removeAttribute('srcset');
      image?.removeAttribute('sizes');
      lastTrigger?.focus();
    });
  </script>
</BaseLayout>
