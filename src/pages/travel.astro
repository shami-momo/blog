---
import BaseLayout from '../layouts/BaseLayout.astro';
import StackedBarChart from '../components/StackedBarChart.astro';
import japanMap from '../assets/maps/japan-map.svg?raw';
import worldMap from '../assets/maps/world-map.svg?raw';
import travelData from '../data/travel.json';
import '../styles/content.css';
import '../styles/travel.css';

interface Trip {
  title: string;
  start: string;
  end: string;
  url?: string;
  emoji?: string;
  description?: string;
  countries?: string[];
  prefectures?: string[];
  prefectures_landed?: string[];
  prefectures_passed?: string[];
  prefectures_walked?: string[];
  prefectures_lived?: string[];
}

const trips = (travelData as Trip[]).toSorted((a, b) => b.start.localeCompare(a.start));
const countries = new Set(trips.flatMap((trip) => trip.countries ?? []));
const prefectureFields = [
  ['prefectures_passed', 1, 'is-passed'],
  ['prefectures_landed', 2, 'is-landed'],
  ['prefectures_walked', 3, 'is-walked'],
  ['prefectures', 4, 'is-stayed'],
  ['prefectures_lived', 5, 'is-stayed'],
] as const;
const prefectureLevels = new Map<string, { score: number; mapClass: string }>();
for (const trip of trips) {
  for (const [field, score, mapClass] of prefectureFields) {
    for (const prefecture of trip[field] ?? []) {
      if (score > (prefectureLevels.get(prefecture)?.score ?? 0)) {
        prefectureLevels.set(prefecture, { score, mapClass });
      }
    }
  }
}
const visitedPrefectures = [...prefectureLevels].filter(([, level]) => level.score >= 3);
const keikenchi = [...prefectureLevels.values()].reduce((total, level) => total + level.score, 0);
const mapData = JSON.stringify({
  countries: [...countries],
  prefectures: [...prefectureLevels].map(([name, level]) => ({
    name,
    mapClass: level.mapClass,
    clickable: level.score >= 3,
  })),
}).replaceAll('<', '\\u003c');
const days = new Set<string>();
const yearlyDaySets = new Map<string, { japan: Set<string>; abroad: Set<string> }>();
for (const trip of trips) {
  const cursor = new Date(`${trip.start}T00:00:00Z`);
  const end = new Date(`${trip.end}T00:00:00Z`);
  const region = trip.countries?.includes('JP') ? 'japan' : 'abroad';
  while (cursor <= end) {
    const date = cursor.toISOString().slice(0, 10);
    const year = date.slice(0, 4);
    const yearly = yearlyDaySets.get(year) ?? { japan: new Set<string>(), abroad: new Set<string>() };
    days.add(date);
    yearly[region].add(date);
    yearlyDaySets.set(year, yearly);
    cursor.setUTCDate(cursor.getUTCDate() + 1);
  }
}
const yearlyDays = [...yearlyDaySets]
  .map(([year, yearly]) => ({ year, japan: yearly.japan.size, abroad: yearly.abroad.size }))
  .toSorted((a, b) => a.year.localeCompare(b.year));
const travelChartDatasets = [
  { label: '일본', data: yearlyDays.map(({ japan }) => japan), color: '--main-bright' },
  { label: '일본 외', data: yearlyDays.map(({ abroad }) => abroad), color: '--main-softer' },
];
const grouped = Map.groupBy(trips, (trip) => trip.start.slice(0, 4));
const formatShort = (date: string) => date.slice(5).replace('-', '.');
---

<BaseLayout title="여행" description="지금까지 다녀온 여행들">
  <article>
    <header class="page-header">
      <h1>여행</h1>
      <p>지역을 선택하면 관련 여행 기록을 볼 수 있습니다.</p>
    </header>

    <div class="content">
      <h2>지금까지 여행을 떠난 날은 <span class="text-highlight">{days.size}일</span>.</h2>

      <StackedBarChart
        id="travelYearChart"
        caption="연도별 여행 일수"
        labels={yearlyDays.map(({ year }) => year)}
        datasets={travelChartDatasets}
        unit="일"
        height="17rem"
      />

      <h2>방문한 국가는 <span class="text-highlight">{countries.size}곳</span>.</h2>
      <figure aria-label="방문한 나라를 표시한 세계 지도">
        <div class="map-wrap" set:html={worldMap}></div>
        <span class="map-attribution">Map adapted from <a href="https://simplemaps.com/resources/svg-world">Simplemaps</a>.</span>
      </figure>

      <h2>방문한 일본의 현은 <span class="text-highlight">{visitedPrefectures.length}곳</span>.</h2>
      <figure aria-label="방문 경험 단계별로 표시한 일본 지도">
        <div class="map-wrap" set:html={japanMap}></div>
        <figcaption>
          <p class="keikenchi-summary">경현치・<span class="keikenchi-value">{keikenchi}점</span></p>
          <ul class="map-legend legend" aria-label="일본 방문 경험 범례">
            <li><span class="map-legend-swatch legend-swatch is-stayed"></span>숙박·거주</li>
            <li><span class="map-legend-swatch legend-swatch is-walked"></span>방문</li>
            <li><span class="map-legend-swatch legend-swatch is-landed"></span>접지</li>
            <li><span class="map-legend-swatch legend-swatch is-passed"></span>통과</li>
          </ul>
          <span class="map-attribution">Map adapted from <a href="https://github.com/Snack-X/keikenchi">Snack-X/keikenchi</a>.</span>
        </figcaption>
      </figure>

      <script type="application/json" id="travelMapData" set:html={mapData}></script>

      <h2>이런 여행들을 했어요.</h2>

      <div id="travelList" class="travel-list-root">
        {[...grouped].map(([year, yearTrips]) => (
          <section class="travel-year-section" aria-labelledby={`year-${year}`}>
            <h3 id={`year-${year}`} class="travel-year">{year}</h3>
            <div class="travel-year-list" role="list">
              {yearTrips.map((trip) => {
                const Tag = trip.url ? 'a' : 'article';
                const dayTrip = trip.start === trip.end;
                return (
                  <Tag
                    class="travel-card"
                    href={trip.url}
                    role="listitem"
                    data-countries={(trip.countries ?? []).join('|')}
                    data-prefectures={prefectureFields.flatMap(([field]) => trip[field] ?? []).join('|')}
                  >
                    <span class="travel-card-period">
                      <time class="travel-card-period-value" datetime={trip.start}>{formatShort(trip.start)}</time>
                      {dayTrip ? (
                        <span class="travel-card-period-value is-note">당일</span>
                      ) : (
                        <>
                          <span class="travel-card-period-arrow" aria-hidden="true">↓</span>
                          <time class="travel-card-period-value" datetime={trip.end}>{formatShort(trip.end)}</time>
                        </>
                      )}
                    </span>
                    <span class="travel-card-content">
                      <span class="travel-card-title">{trip.title}<span class="travel-card-icon">{trip.emoji ?? '✈️'}</span></span>
                      {trip.description && <span class="travel-card-description">{trip.description}</span>}
                    </span>
                    {trip.url && (
                      <svg class="travel-card-arrow" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
                    )}
                  </Tag>
                );
              })}
            </div>
          </section>
        ))}
      </div>

      <dialog id="travelPopup" class="travel-popup modal-surface" aria-labelledby="travelPopupTitle">
        <header class="travel-popup-header">
          <h2 id="travelPopupTitle">여행 목록</h2>
          <button class="travel-popup-close" type="button" aria-label="팝업 닫기" data-popup-close>
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 6 6 18"></path><path d="m6 6 12 12"></path>
            </svg>
          </button>
        </header>
        <div id="travelPopupList" class="travel-popup-list"></div>
      </dialog>
    </div>
  </article>
</BaseLayout>

<script>
  interface MapData {
    countries: string[];
    prefectures: { name: string; mapClass: string; clickable: boolean }[];
  }

  const dataElement = document.querySelector<HTMLScriptElement>('#travelMapData');
  const popup = document.querySelector<HTMLDialogElement>('#travelPopup');
  const popupTitle = document.querySelector<HTMLElement>('#travelPopupTitle');
  const popupList = document.querySelector<HTMLElement>('#travelPopupList');
  let popupTrigger: SVGElement | null = null;

  if (dataElement && popup && popupTitle && popupList) {
    const mapData = JSON.parse(dataElement.textContent ?? '{}') as MapData;

    const openPopup = (field: 'countries' | 'prefectures', value: string, label: string, trigger: SVGElement) => {
      const fragment = document.createDocumentFragment();

      document.querySelectorAll<HTMLElement>('#travelList .travel-year-section').forEach((section) => {
        const cards = [...section.querySelectorAll<HTMLElement>('.travel-card')]
          .filter((card) => (card.dataset[field]?.split('|') ?? []).includes(value));
        if (!cards.length) return;

        const clone = section.cloneNode(true) as HTMLElement;
        clone.removeAttribute('aria-labelledby');
        clone.querySelector('h3')?.removeAttribute('id');
        clone.querySelector('.travel-year-list')?.replaceChildren(...cards.map((card) => card.cloneNode(true)));
        fragment.append(clone);
      });

      popupTitle.textContent = label;
      popupList.replaceChildren(fragment);
      popupTrigger = trigger;
      popup.showModal();
    };

    const setupArea = (
      type: 'country' | 'prefecture',
      value: string,
      mapClass: string,
      clickable = true,
    ) => {
      const attribute = type === 'country' ? 'data-country' : 'data-name';
      const elements = [...document.querySelectorAll<SVGGraphicsElement>(
        `${type === 'country' ? '.world-map' : '.japan-map'} [${attribute}="${CSS.escape(value)}"]`,
      )];
      if (!elements.length) return;

      elements.forEach((element) => {
        element.classList.add(mapClass);
        if (!element.querySelector(':scope > title')) {
          const title = document.createElementNS('http://www.w3.org/2000/svg', 'title');
          title.textContent = element.getAttribute('name') ?? value;
          element.prepend(title);
        }
      });
      if (!clickable) return;

      const target = elements.reduce((largest, element) => {
        try {
          const box = element.getBBox();
          const largestBox = largest.getBBox();
          return box.width * box.height > largestBox.width * largestBox.height ? element : largest;
        } catch {
          return largest;
        }
      });
      const label = target.getAttribute('name') ?? value;
      target.setAttribute('tabindex', '0');
      target.setAttribute('role', 'button');
      target.setAttribute('aria-label', `${label} 여행 보기`);

      const activate = () => openPopup(type === 'country' ? 'countries' : 'prefectures', value, label, target);
      elements.forEach((element) => {
        element.classList.add('is-clickable');
        element.addEventListener('click', activate);
        element.addEventListener('pointerenter', () => elements.forEach((part) => part.classList.add('is-map-active')));
        element.addEventListener('pointerleave', () => elements.forEach((part) => part.classList.remove('is-map-active')));
      });
      target.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          activate();
        }
      });
    };

    mapData.countries.forEach((country) => setupArea('country', country, 'visited'));
    mapData.prefectures.forEach(({ name, mapClass, clickable }) => {
      setupArea('prefecture', name, mapClass, clickable);
    });

    popup.querySelector('[data-popup-close]')?.addEventListener('click', () => popup.close());
    popup.addEventListener('click', (event) => {
      const bounds = popup.getBoundingClientRect();
      const outside = event.clientX < bounds.left || event.clientX > bounds.right
        || event.clientY < bounds.top || event.clientY > bounds.bottom;
      if (outside) popup.close();
    });
    popup.addEventListener('close', () => {
      popupTrigger?.focus();
      popupTrigger = null;
    });
  }
</script>
